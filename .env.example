# Copia este archivo a .env.local y rellena tu clave.
# Consíguela en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Opcionales: claves propias de cada proveedor. Con una de ellas, los modelos
# de ese proveedor (openai/…, anthropic/…, google/…) se llaman con su API en vez
# de por OpenRouter; en Ajustes puedes volver a mandarlos por OpenRouter.
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# Opcionales: se envían a OpenRouter para identificar tu app.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Models play Codenames

# Codenames: máximo de partidas activas por cliente y carpeta de datos.
CODENAMES_MAX_ACTIVE=2
# CODENAMES_DATA_DIR=./data/codenames
